# ==========================================
# LLM Configuration (Powered by LiteLLM)
# ==========================================
ALLOW_CLOUD_LLM=true    \\ BAD OPSEC
ALLOW_CLOUD_LLM_FOR_ONION=true  \\BAD OPSEC
# 1. Google Gemini 
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-2.5-flash

# 2. OpenAI / ChatGPT 
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# 3. Anthropic / Claude 
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-sonnet-20240620

# 4. Local / Offline LLMs via Ollama 
# No API key needed for local execution
# LLM_MODEL=ollama/llama3
# LLM_API_BASE=http://localhost:11434

# ==========================================
# Web Dashboard Security (dashboard.py)
# ==========================================
# Mandatory X-API-Token protecting all /api/* routes (including over SSH tunnels).
# If omitted, an ephemeral random token is generated on startup and printed locally.
# SECURITY: NEVER expose dashboard.py beyond localhost (127.0.0.1).
# DASHBOARD_API_TOKEN=change_me_to_a_long_random_secret_token